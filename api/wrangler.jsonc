{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-passkeys-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "CHALLENGES", "class_name": "ChallengeStore" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tools-passkeys-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChallengeStore"] }],
  "vars": {
    "RP_ID": "localhost",
    "RP_NAME": "tools.passkeys.dev",
    "EXPECTED_ORIGINS": "http://localhost:8787,http://localhost:8080"
  }
}
