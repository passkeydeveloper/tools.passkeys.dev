{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-passkeys-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../_site",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHALLENGES", "class_name": "ChallengeStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChallengeStore"] }],
  "vars": {
    "RP_ID": "localhost",
    "RP_NAME": "tools.passkeys.dev",
    "EXPECTED_ORIGINS": "http://localhost:8787"
  }
}
