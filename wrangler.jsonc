{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools-passkeys-dev",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The Eleventy build, served as static assets
  "assets": {
    "directory": "_site"
  },
  // Each version uploaded from a non-production branch gets a preview URL on workers.dev
  "workers_dev": true,
  "preview_urls": true
}
