---
layout: layouts/base.njk
title: WebAuthn Response Decoder | Passkey Developer Tools
description: Get a human-readable view into WebAuthn registration and authentication responses.
extra_scripts:
  - https://unpkg.com/psl@1.9.0/dist/psl.min.js
  - /assets/js/codeflask.1.4.1.min.js
---
<div class="container">
  <div class="text-center">
    <h2 class="mt-1 mb-3">WebAuthn<br />Response Decoder</h2>
    <p>
      Get a human-readable view into WebAuthn registration and authentication responses.
    </p>
  </div>

  <div class="card mt-4 mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <span class="form-label fw-bold">WebAuthn Response (JSON)</span>
      </div>
      <p class="form-text">
        Paste the JSON-ified output from
        <code>navigator.credentials.create()</code> or
        <code>navigator.credentials.get()</code>
        below.
        <code>ArrayBuffer</code> values should be encoded into base64url strings.
        </p>
        <div class="alert alert-primary" role="alert">
            💡 Hint: Pass a WebAuthn API response into <a href="https://developer.mozilla.org/en-US/docs/Web/API/PublicKeyCredential/toJSON#examples" target="_blank">
            <code>JSON.stringify()</code></a> and then paste the output below.
        </div>

      <!-- Sample data loader -->
      <div class="mb-3">
        <button
          id="sampleDataToggle"
          class="btn btn-link ps-0 text-decoration-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#sampleDataCollapse"
          aria-expanded="false"
          aria-controls="sampleDataCollapse"
        >
          <i class="bi bi-chevron-right sample-data-chevron"></i>
          Load Sample Responses
        </button>
        <div class="collapse" id="sampleDataCollapse">
          <div class="row g-2 align-items-end pt-1">
            <div class="col-6 col-sm-3">
              <label for="sampleType" class="form-label">Passkey Type</label>
              <select id="sampleType" class="form-select form-select-sm">
                <option value="dbp">Device-bound</option>
                <option value="synced">Synced</option>
              </select>
            </div>
            <div class="col-6 col-sm-3">
              <label for="sampleCeremony" class="form-label">Ceremony</label>
              <select id="sampleCeremony" class="form-select form-select-sm">
                <option value="create">Create</option>
                <option value="get">Get</option>
              </select>
            </div>
            <div class="col-6 col-sm-3">
              <label for="sampleFlow" class="form-label">Flow</label>
              <select id="sampleFlow" class="form-select form-select-sm">
                <option value="securitykey">Security Key</option>
                <option value="localmanager">Local Credential Manager</option>
                <option value="nearby">Nearby Device</option>
              </select>
            </div>
            <div class="col-6 col-sm-3">
              <button id="loadSampleBtn" type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>
                Load Sample
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- JSON input -->
      <!-- deno-fmt-ignore -->
      <div
        id="jsonEditor"
        class="form-control p-0 json-editor"
      ></div>

      <!-- Debug info -->
      <div
        id="logOutput"
        class="p-3 mt-3 bg-body-secondary border rounded font-monospace small d-none log-output-scroll"
      >
      </div>

      <!-- Parsed output -->
      <section id="parsedOutput" class="mt-3 d-none">
        <span id="parsedTitle" class="form-label fw-bold">{parsedTitle}</span>
        <div class="parsed-json-scroll">
          <andypf-json-viewer
            id="parsedJSON"
            expanded="5"
            indent="3"
            show-data-types="false"
            show-size="false"
            theme='{"base00": "var(--bs-body-bg)","base01": "var(--bs-tertiary-bg)","base02": "var(--bs-border-color)","base03": "var(--bs-secondary-color)","base04": "var(--bs-secondary-color)","base05": "var(--bs-body-color)","base06": "var(--bs-body-color)","base07": "var(--bs-body-color)","base08": "var(--jv-literal)","base09": "var(--jv-string)","base0A": "var(--jv-regexp)","base0B": "var(--jv-number)","base0C": "var(--jv-number)","base0D": "var(--jv-accent)","base0E": "var(--jv-literal)","base0F": "var(--jv-number)"}'
          >
            {parsedOutput}
          </andypf-json-viewer>
        </div>
      </section>
    </div>
  </div>
</div>

<script type="importmap">
  {
    "imports": {
      "json-viewer": "/assets/js/json-viewer.2.2.0.esm.min.js",
      "tiny-cbor": "/assets/js/tiny-cbor.0.3.2.esm.min.js",
      "tiny-encodings": "/assets/js/tiny-encodings.0.2.11.esm.min.js"
    }
  }
</script>
<script src="./script.js" type="module"></script>
