---
layout: layouts/base.njk
title: WebAuthn Response Decoder | Passkey Developer Tools
description: Get a human-readable view into WebAuthn registration and authentication responses.
extra_scripts:
  - https://unpkg.com/psl@1.9.0/dist/psl.min.js
  - /assets/js/codeflask.1.4.1.min.js
---
<div class="container">
  <div class="text-center">
    <h2 class="mt-1 mb-3">WebAuthn<br />Response Decoder</h2>
    <p>
      Get a human-readable view into WebAuthn registration and authentication responses.
    </p>
  </div>

  <div class="card mt-4 mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center">
        <span class="form-label fw-bold">WebAuthn Response (JSON)</span>
      </div>
      <p class="form-text">
        Paste the JSON-ified output from
        <code>navigator.credentials.create()</code> or
        <code>navigator.credentials.get()</code>
        below.
        <code>ArrayBuffer</code> values should be encoded into base64url strings.
        <span class="fw-bold">
          (Hint: Try passing a WebAuthn API response into
          <a href="https://developer.mozilla.org/en-US/docs/Web/API/PublicKeyCredential/toJSON#examples" target="_blank">
            <code>JSON.stringify()</code>
          </a>
          and then pasting the output below.)
        </span>
      </p>

      <!-- JSON input -->
      <!-- deno-fmt-ignore -->
      <div
        id="jsonEditor"
        class="form-control p-0"
        style="height: 350px; position: relative"
      ></div>

      <!-- Debug info -->
      <div
        id="logOutput"
        class="p-3 mt-3 bg-body-secondary border rounded font-monospace small d-none"
        style="max-height: 300px; overflow-y: auto"
      >
      </div>

      <!-- Parsed output -->
      <section id="parsedOutput" class="mt-3 d-none">
        <span id="parsedTitle" class="form-label fw-bold">{parsedTitle}</span>
        <div style="overflow-x: scroll; font-size: 0.8em">
          <andypf-json-viewer
            id="parsedJSON"
            expanded="5"
            indent="3"
            show-data-types="false"
            show-size="false"
            theme='{"base00": "var(--bs-body-bg)","base01": "var(--bs-tertiary-bg)","base02": "var(--bs-border-color)","base03": "var(--bs-secondary-color)","base04": "var(--bs-secondary-color)","base05": "var(--bs-body-color)","base06": "var(--bs-body-color)","base07": "var(--bs-body-color)","base08": "#CC342B","base09": "#D63384","base0A": "#FBA922","base0B": "#198844","base0C": "#3971ED","base0D": "#FFBF3B","base0E": "#4F559C","base0F": "#3971ED"}'
          >
            {parsedOutput}
          </andypf-json-viewer>
        </div>
      </section>
    </div>
  </div>
</div>

<script type="importmap">
  {
    "imports": {
      "json-viewer": "/assets/js/json-viewer.2.2.0.esm.min.js",
      "tiny-cbor": "/assets/js/tiny-cbor.0.3.2.esm.min.js",
      "tiny-encodings": "/assets/js/tiny-encodings.0.2.11.esm.min.js"
    }
  }
</script>
<script src="./script.js" type="module"></script>
